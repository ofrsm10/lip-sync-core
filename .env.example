# Lip Sync Core Environment Configuration
# Copy this file to .env and fill in your actual values

# ======================
# TELEGRAM CONFIGURATION
# ======================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ======================
# AWS CONFIGURATION
# ======================
# AWS Region for deployment
AWS_REGION=us-east-1

# S3 Bucket name (will be created if doesn't exist)
S3_BUCKET_NAME=lip-sync-core-prod-storage

# SQS Queue URLs (will be created by CloudFormation)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/lip-sync-core-prod-processing
SQS_DEAD_LETTER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/lip-sync-core-prod-dlq

# ======================
# DYNAMODB CONFIGURATION
# ======================
# Table names (will be created by CloudFormation)
DYNAMODB_USERS_TABLE=lip-sync-core-prod-users
DYNAMODB_JOBS_TABLE=lip-sync-core-prod-jobs
DYNAMODB_RESULTS_TABLE=lip-sync-core-prod-results

# ======================
# APPLICATION CONFIGURATION
# ======================
# Environment name (dev, staging, prod)
ENVIRONMENT=prod

# Project name for resource naming
PROJECT_NAME=lip-sync-core

# Logging level
LOG_LEVEL=INFO

# Model configuration
MODEL_VERSION=latest
MODEL_NAME=cnn_model

# ======================
# PROCESSING CONFIGURATION
# ======================
# Maximum video file size in bytes (50MB)
MAX_VIDEO_SIZE=52428800

# Video processing timeout in seconds
PROCESSING_TIMEOUT=300

# Maximum concurrent processors
MAX_CONCURRENT_PROCESSORS=5

# ======================
# DEVELOPMENT CONFIGURATION
# ======================
# Local development settings
DEV_MODE=false
LOCAL_MODEL_PATH=./cnn_model/cnn_model.pth
LOCAL_DATA_PATH=./data_samples

# ======================
# SECURITY CONFIGURATION
# ======================
# Enable encryption at rest
ENABLE_ENCRYPTION=true

# Data retention period in days
DATA_RETENTION_DAYS=30

# ======================
# MONITORING CONFIGURATION
# ======================
# CloudWatch log retention in days
LOG_RETENTION_DAYS=14

# Enable detailed monitoring
DETAILED_MONITORING=true

# Alarm notification email (optional)
ALARM_EMAIL=admin@yourcompany.com

# ======================
# SCALING CONFIGURATION
# ======================
# Auto scaling settings
MIN_PROCESSORS=1
MAX_PROCESSORS=10
TARGET_CPU_UTILIZATION=70

# Queue depth scaling threshold
SCALE_OUT_QUEUE_DEPTH=5
SCALE_IN_QUEUE_DEPTH=1

# ======================
# ADVANCED CONFIGURATION
# ======================
# Custom feature extraction parameters
TEETH_LOWER_HSV=110,0,65
TEETH_UPPER_HSV=177,127,204
TONGUE_LOWER_HSV=0,20,60
TONGUE_UPPER_HSV=20,180,255

# Model hyperparameters
SEQUENCE_LENGTH=60
FEATURE_DIMENSIONS=4
BATCH_SIZE=1
LEARNING_RATE=0.001

# ======================
# DEVELOPMENT OVERRIDES
# ======================
# Override settings for local development
# Uncomment and modify as needed

# TELEGRAM_BOT_TOKEN=your_dev_bot_token
# AWS_REGION=us-west-2
# ENVIRONMENT=dev
# LOG_LEVEL=DEBUG
# DEV_MODE=true